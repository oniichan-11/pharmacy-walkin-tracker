# ---------------------------------------------------------------------------
# COPY this file's contents into your Streamlit app's Secrets box:
#   share.streamlit.io -> your app -> ⋮ -> Settings -> Secrets -> paste -> Save
# Do NOT commit real secrets. Locally, you may instead create
#   .streamlit/secrets.toml  (git-ignored) with the same content.
#
# With no secrets at all, the app runs in DEV mode on a local CSV that resets on
# every redeploy — fine for testing, not for real staff use.
# ---------------------------------------------------------------------------

# ---- Storage: Supabase (recommended) ---------------------------------------
# Free hosted Postgres, no card required. From your Supabase project:
#   url  = Project Settings -> Data API -> Project URL
#   key  = Project Settings -> API Keys -> service_role  (secret; server-side only)
# Create the table once with the SQL in the README before first use.
[supabase]
url   = "https://YOUR-PROJECT-REF.supabase.co"
key   = "YOUR-SERVICE-ROLE-KEY"
table = "requests"

# ---- Admin PIN (optional) --------------------------------------------------
# Guards ONLY the edit / delete controls on the Browse screen. Sign-in has no
# PIN. Omit this section to keep the default (9999).
[branch_pins]
admin_pin = "4321"

# ---------------------------------------------------------------------------
# Alternative storage: Google Sheets (only if you can create a service-account
# key — many Google orgs now block this). If you use it, delete the [supabase]
# section above; the app prefers Supabase when both are present.
# ---------------------------------------------------------------------------
# [gsheets]
# spreadsheet = "https://docs.google.com/spreadsheets/d/XXXX/edit"
# worksheet   = "requests"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@...iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
# universe_domain = "googleapis.com"
